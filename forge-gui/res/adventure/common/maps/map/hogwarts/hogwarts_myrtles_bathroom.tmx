  <object id="301" name="Moaning Myrtle" type="dialog" x="247.5" y="176" width="9" height="13" gid="26502">
   <properties>
    <property name="dialog" value="[{&quot;text&quot;: &quot;Myrtle: I died here. I heard a boy speaking, and then I saw a pair of enormous yellow eyes by those sinks. Look at the tap. There's a little snake on it.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Ask Harry to speak to the snake.&quot;, &quot;text&quot;: &quot;Harry whispers in Parseltongue. The basin sinks into the floor, revealing a passage into the rock.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Descend into the Chamber.&quot;, &quot;action&quot;: [{&quot;setQuestFlag&quot;: {&quot;key&quot;: &quot;hpChamberOpened&quot;, &quot;val&quot;: 1}}]}]}], &quot;condition&quot;: [{&quot;checkQuestFlag&quot;: &quot;hpChamberOpened&quot;, &quot;not&quot;: true}]}, {&quot;text&quot;: &quot;Myrtle: The stairs are where the sink used to be. Try to avoid looking it in the eyes.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Continue&quot;}], &quot;condition&quot;: [{&quot;checkQuestFlag&quot;: &quot;hpChamberOpened&quot;}]}]" />
   </properties>
  </object>
  <object id="302" name="Waterlogged diary" type="dialog" x="128" y="256" width="16" height="16" gid="18084">
   <properties>
    <property name="dialog" value="[{&quot;text&quot;: &quot;The blank pages darken for an instant. You glimpse a prefect called Tom Riddle pointing the blame at Hagrid. Then the ink sinks back into the paper.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Continue&quot;}]}]" />
   </properties>
  </object>
