  <object id="221" name="A loose tapestry" type="dialog" x="128" y="416" width="16" height="16" gid="18084">
   <properties>
    <property name="hidden" value="false" type="bool" />
    <property name="dialog" value="[{&quot;text&quot;: &quot;A loose tapestry: Cold air stirs the cloth. Behind it, a narrow stair descends toward the library. Mind the treacherous step.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Lift the tapestry&quot;, &quot;text&quot;: &quot;The concealed entrance opens. You can use this passage again when you return.&quot;, &quot;action&quot;: [{&quot;setQuestFlag&quot;: {&quot;key&quot;: &quot;hpTapestryFound&quot;, &quot;val&quot;: 1}}], &quot;options&quot;: [{&quot;name&quot;: &quot;Continue&quot;}]}, {&quot;name&quot;: &quot;Leave it alone&quot;}]}]" />
   </properties>
  </object>
  <object id="40" name="Hidden tapestry staircase" type="entry" x="80" y="416" width="16" height="32">
   <properties>
    <property name="teleport" value="../common/maps/map/hogwarts/hogwarts_library.tmx" />
    <property name="teleportObjectId" value="40" type="int" />
    <property name="direction" value="right" />
    <property name="requiredQuestFlag" value="hpTapestryFound" />
    <property name="lockedText" value="The tapestry conceals something. Examine the loose cloth nearby." />
   </properties>
  </object>
  <object id="222" name="Barnabas the Barmy's tapestry" type="dialog" x="640" y="176" width="16" height="16" gid="18084">
   <properties>
    <property name="hidden" value="false" type="bool" />
    <property name="dialog" value="[{&quot;text&quot;: &quot;Barnabas the Barmy's tapestry: Woven trolls attempt an ungainly ballet. Across from it is an unusually blank stretch of wall.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Walk past while thinking of a place to shelter.&quot;, &quot;text&quot;: &quot;You pass the wall once, concentrating on what you need.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Turn and pass a second time.&quot;, &quot;text&quot;: &quot;You keep the need firmly in mind. The stone seems to ripple.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Pass a third time, concentrating on a room for shelter.&quot;, &quot;text&quot;: &quot;A door appears in the blank wall. The Room of Requirement has answered.&quot;, &quot;action&quot;: [{&quot;setQuestFlag&quot;: {&quot;key&quot;: &quot;hpRequirementFound&quot;, &quot;val&quot;: 1}}], &quot;options&quot;: [{&quot;name&quot;: &quot;Continue&quot;}]}, {&quot;name&quot;: &quot;Stop searching&quot;}]}, {&quot;name&quot;: &quot;Stop searching&quot;}]}, {&quot;name&quot;: &quot;Leave&quot;}]}]" />
   </properties>
  </object>
  <object id="30" name="Room of Requirement" type="entry" x="672" y="192" width="16" height="32">
   <properties>
    <property name="teleport" value="../common/maps/map/hogwarts/hogwarts_requirement.tmx" />
    <property name="teleportObjectId" value="1" type="int" />
    <property name="direction" value="right" />
    <property name="requiredQuestFlag" value="hpRequirementFound" />
    <property name="lockedText" value="Only a blank wall. Perhaps the tapestry opposite offers a clue." />
   </properties>
  </object>
