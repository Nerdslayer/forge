    <property name="threatRange" value="0" type="int" />
    <property name="fleeRange" value="0" type="int" />
    <property name="dialog" value="[{&quot;text&quot;: &quot;Dumbledore: Welcome. We are far from the world Hogwarts once knew. What brings you to my office?&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;The town sent me. How can I help?&quot;, &quot;condition&quot;: [{&quot;checkQuestFlag&quot;: &quot;hpCastleQuestAccepted&quot;}, {&quot;checkQuestFlag&quot;: &quot;questCompleted:90701&quot;, &quot;not&quot;: true}, {&quot;defeatedEnemy&quot;: &quot;HP Voldemort&quot;, &quot;not&quot;: true}], &quot;text&quot;: &quot;Dumbledore: Hogwarts was torn from its own world and carried here. Voldemort followed. He waits beyond Aragog, at the northern end of the forest. Please defeat him. You need not return here; his defeat is the help we need. The castle must not become his foothold on this plane.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;I will confront him.&quot;, &quot;action&quot;: [{&quot;setQuestFlag&quot;: {&quot;key&quot;: &quot;hpCastleBriefed&quot;, &quot;val&quot;: 1}}, {&quot;setMapFlag&quot;: {&quot;key&quot;: &quot;hpStoryConversation&quot;, &quot;val&quot;: 1}}]}, {&quot;name&quot;: &quot;I need more time.&quot;}]}, {&quot;name&quot;: &quot;I have already defeated Voldemort.&quot;, &quot;condition&quot;: [{&quot;checkQuestFlag&quot;: &quot;hpCastleQuestAccepted&quot;}, {&quot;checkQuestFlag&quot;: &quot;questCompleted:90701&quot;, &quot;not&quot;: true}, {&quot;defeatedEnemy&quot;: &quot;HP Voldemort&quot;}], &quot;text&quot;: &quot;Dumbledore: Then you have already done what I would have asked. Your earlier victory counts. You have given this displaced school a chance to find its way in a new world. Thank you.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;I am glad I could help.&quot;, &quot;action&quot;: [{&quot;setQuestFlag&quot;: {&quot;key&quot;: &quot;hpCastleBriefed&quot;, &quot;val&quot;: 1}}, {&quot;setMapFlag&quot;: {&quot;key&quot;: &quot;hpStoryConversation&quot;, &quot;val&quot;: 1}}]}]}, {&quot;name&quot;: &quot;Tell me about the castle.&quot;, &quot;text&quot;: &quot;Dumbledore: The displacement brought fragments of our surroundings with us, even a tunnel beneath an irritable tree. Our portraits, books, and familiar routines help the students feel at home.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Continue&quot;}]}, {&quot;name&quot;: &quot;Begin duel&quot;, &quot;action&quot;: [{&quot;battleWithActorID&quot;: -1}], &quot;condition&quot;: [{&quot;duelReady&quot;: true}]}, {&quot;name&quot;: &quot;Ask about a rematch&quot;, &quot;condition&quot;: [{&quot;duelReady&quot;: true, &quot;not&quot;: true}], &quot;text&quot;: &quot;Dumbledore: Well played. I particularly admired your patience when the board turned against you. If you would like another match, my door will be open tomorrow.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Continue&quot;}]}, {&quot;name&quot;: &quot;Perhaps later&quot;}]}]" />
    <property name="defeatDialog" value="[{&quot;text&quot;: &quot;Dumbledore: Well played. I particularly admired your patience when the board turned against you. If you would like another match, my door will be open tomorrow.&quot;, &quot;options&quot;: [{&quot;name&quot;: &quot;Continue&quot;}]}]" />
    <property name="rematchNextDay" value="true" type="bool" />
